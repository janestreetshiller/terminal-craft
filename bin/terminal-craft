#!/bin/bash
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
SELF="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
if [[ -x "$SELF/terminal-craft-bin" ]]; then
  GAME="$SELF/terminal-craft-bin"
  CONF="$SELF/../Resources/kitty-minigame.conf"
else
  ROOT="$(cd "$SELF/.." && pwd)"
  GAME="$ROOT/target/release/terminal-craft"
  CONF="$ROOT/kitty-minigame.conf"
  if [[ ! -x "$GAME" ]]; then
    export CMAKE_POLICY_VERSION_MINIMUM="${CMAKE_POLICY_VERSION_MINIMUM:-3.5}"
    cargo build --release --locked --manifest-path "$ROOT/Cargo.toml"
  fi
fi
case "${1:-}" in
  --here) shift; exec "$GAME" --here "$@" ;;
  --terminal) shift ;;
  "") exec "$GAME" --native ;;
  *) exec "$GAME" "$@" ;;
esac
KITTY="${TERMINAL_CRAFT_KITTY:-}"
if [[ -z "$KITTY" ]]; then
  for candidate in /Applications/kitty.app/Contents/MacOS/kitty "$HOME/Applications/k1tty.app/Contents/MacOS/kitty" /opt/homebrew/bin/kitty /usr/bin/kitty; do
    if [[ -x "$candidate" ]]; then KITTY="$candidate"; break; fi
  done
fi
if [[ ! -x "$KITTY" ]]; then
  printf 'Terminal mode needs Kitty. The default native window does not. Use --here for terminal fallback.\n' >&2
  exit 1
fi
exec "$KITTY" --detach --title "Terminal Craft — Terminal Mode" --config "$CONF" \
  --override remember_window_size=no --override confirm_os_window_close=0 \
  --override macos_quit_when_last_window_closed=yes \
  --override shell_integration=disabled --directory "$HOME" -e "$GAME" --here "$@"
